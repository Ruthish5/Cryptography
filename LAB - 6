from math import gcd

# E = 4, T = 19
# B = 1, U = 20

p1 = 4
p2 = 19

c1 = 1
c2 = 20

print("Possible Affine Cipher Keys:\n")

for a in range(26):

    if gcd(a, 26) == 1:

        for b in range(26):

            if (a * p1 + b) % 26 == c1 and \
               (a * p2 + b) % 26 == c2:

                print("a =", a)
                print("b =", b)
