key = [
    [9, 4],
    [5, 7]
]

# Chosen plaintext vectors
plaintexts = [
    [1, 0],
    [0, 1]
]

print("Chosen Plaintext Attack\n")

recovered = []

for p in plaintexts:

    c1 = (key[0][0] * p[0] + key[0][1] * p[1]) % 26
    c2 = (key[1][0] * p[0] + key[1][1] * p[1]) % 26

    recovered.append([c1, c2])

    print("Plaintext:", p)
    print("Ciphertext:", [c1, c2])

print("\nRecovered Key Matrix:")

print(recovered[0][0], recovered[1][0])
print(recovered[0][1], recovered[1][1])
