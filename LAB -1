#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int key, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key (1-25): ");
    scanf("%d", &key);

    if (key < 1 || key > 25)
    {
        printf("Invalid key\n");
        return 0;
    }

    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = text[i];

        if (ch >= 'A' && ch <= 'Z')
            ch = (ch - 'A' + key) % 26 + 'A';

        else if (ch >= 'a' && ch <= 'z')
            ch = (ch - 'a' + key) % 26 + 'a';

        printf("%c", ch);
    }

    return 0;
}
