key = input("Enter keyword: ").upper()
text = input("Enter plaintext: ").upper()

# Create matrix
letters = ""

for ch in key + "ABCDEFGHIKLMNOPQRSTUVWXYZ":
    if ch == "J":
        ch = "I"

    if ch.isalpha() and ch not in letters:
        letters += ch

matrix = [letters[i:i+5] for i in range(0, 25, 5)]

print("\nPlayfair Matrix:")
for row in matrix:
    print(" ".join(row))

# Remove spaces and replace J with I
text = "".join(ch for ch in text if ch.isalpha())
text = text.replace("J", "I")

# Prepare pairs
prepared = ""
i = 0

while i < len(text):
    first = text[i]

    if i + 1 >= len(text):
        prepared += first + "X"
        i += 1

    elif first == text[i + 1]:
        prepared += first + "X"
        i += 1

    else:
        prepared += first + text[i + 1]
        i += 2

print("Prepared text:", prepared)

def find_position(letter):
    for row in range(5):
        for col in range(5):
            if matrix[row][col] == letter:
                return row, col

encrypted = ""

for i in range(0, len(prepared), 2):

    a = prepared[i]
    b = prepared[i + 1]

    r1, c1 = find_position(a)
    r2, c2 = find_position(b)

    if r1 == r2:
        encrypted += matrix[r1][(c1 + 1) % 5]
        encrypted += matrix[r2][(c2 + 1) % 5]

    elif c1 == c2:
        encrypted += matrix[(r1 + 1) % 5][c1]
        encrypted += matrix[(r2 + 1) % 5][c2]

    else:
        encrypted += matrix[r1][c2]
        encrypted += matrix[r2][c1]

print("Encrypted text:", encrypted)
