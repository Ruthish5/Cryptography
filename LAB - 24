import math

e = 31
n = 3599

p = 0
q = 0

# Find p and q
for i in range(2, int(math.sqrt(n)) + 1):

    if n % i == 0:
        p = i
        q = n // i
        break


print("p =", p)
print("q =", q)

phi = (p - 1) * (q - 1)

print("phi(n) =", phi)

# Find private exponent
d = pow(e, -1, phi)

print("Public key :", (e, n))
print("Private key:", (d, n))

# Verification
print("Verification:")
print((e * d) % phi)
