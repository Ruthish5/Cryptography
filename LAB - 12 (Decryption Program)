cipher = "UKIXUKYBFMUBGMFYIVNXMFGJRLHBHBCMIPFAYYMMUHAPCZWQ"

# Inverse key
inverse = [
    [5, 12],
    [15, 25]
]

plaintext = ""

for i in range(0, len(cipher), 2):

    c1 = ord(cipher[i]) - 65
    c2 = ord(cipher[i + 1]) - 65

    p1 = (5 * c1 + 12 * c2) % 26
    p2 = (15 * c1 + 25 * c2) % 26

    plaintext += chr(p1 + 65)
    plaintext += chr(p2 + 65)

print("Decrypted text:", plaintext)
