matrix = [
    ['M', 'F', 'H', 'I', 'K'],
    ['U', 'N', 'O', 'P', 'Q'],
    ['Z', 'V', 'W', 'X', 'Y'],
    ['E', 'L', 'A', 'R', 'G'],
    ['D', 'S', 'T', 'B', 'C']
]

text = input("Enter plaintext: ").upper()

text = text.replace("J", "I")

# Remove spaces and symbols
clean = ""

for ch in text:
    if ch.isalpha():
        clean += ch


# Prepare pairs
prepared = ""

i = 0

while i < len(clean):

    first = clean[i]

    if i + 1 >= len(clean):

        prepared += first + "X"
        i += 1

    elif first == clean[i + 1]:

        prepared += first + "X"
        i += 1

    else:

        prepared += first + clean[i + 1]
        i += 2


def find_position(letter):

    for row in range(5):
        for col in range(5):

            if matrix[row][col] == letter:
                return row, col


encrypted = ""

for i in range(0, len(prepared), 2):

    a = prepared[i]
    b = prepared[i + 1]

    r1, c1 = find_position(a)
    r2, c2 = find_position(b)

    # Same row
    if r1 == r2:

        encrypted += matrix[r1][(c1 + 1) % 5]
        encrypted += matrix[r2][(c2 + 1) % 5]

    # Same column
    elif c1 == c2:

        encrypted += matrix[(r1 + 1) % 5][c1]
        encrypted += matrix[(r2 + 1) % 5][c2]

    # Rectangle
    else:

        encrypted += matrix[r1][c2]
        encrypted += matrix[r2][c1]


print("\nPlayfair Matrix:")

for row in matrix:
    print(" ".join(row))

print("\nPrepared text:", prepared)
print("Encrypted text:", encrypted)
