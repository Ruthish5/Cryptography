#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100];
    char key[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = text[i];

        if (ch >= 'A' && ch <= 'Z')
            printf("%c", key[ch - 'A']);

        else if (ch >= 'a' && ch <= 'z')
            printf("%c", tolower(key[ch - 'a']));

        else
            printf("%c", ch);
    }

    return 0;
}
