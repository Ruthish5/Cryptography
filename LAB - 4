text = input("Enter plaintext: ").upper()
key = input("Enter key: ").upper()

result = ""
j = 0

for ch in text:

    if ch.isalpha():

        p = ord(ch) - 65
        k = ord(key[j % len(key)]) - 65

        result += chr((p + k) % 26 + 65)

        j += 1

    else:
        result += ch

print("Encrypted text:", result)
