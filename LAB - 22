P10 = [3,5,2,7,4,10,1,9,8,6]
P8 = [6,3,7,4,8,5,10,9]

IP = [2,6,3,1,4,8,5,7]
IP_INV = [4,1,3,5,7,2,8,6]

EP = [4,1,2,3,2,3,4,1]
P4 = [2,4,3,1]

S0 = [
    [1,0,3,2],
    [3,2,1,0],
    [0,2,1,3],
    [3,1,3,2]
]

S1 = [
    [0,1,2,3],
    [2,0,1,3],
    [3,0,1,0],
    [2,1,0,3]
]


def permute(bits, table):
    return ''.join(bits[i-1] for i in table)


def left_shift(bits, n):
    return bits[n:] + bits[:n]


def xor(a, b):
    return ''.join(str(int(x) ^ int(y)) for x, y in zip(a, b))


def generate_keys(key):

    temp = permute(key, P10)

    left = temp[:5]
    right = temp[5:]

    left = left_shift(left, 1)
    right = left_shift(right, 1)

    k1 = permute(left + right, P8)

    left = left_shift(left, 2)
    right = left_shift(right, 2)

    k2 = permute(left + right, P8)

    return k1, k2


def sbox(bits, box):

    row = int(bits[0] + bits[3], 2)
    col = int(bits[1] + bits[2], 2)

    return format(box[row][col], '02b')


def fk(bits, key):

    left = bits[:4]
    right = bits[4:]

    temp = permute(right, EP)
    temp = xor(temp, key)

    result = sbox(temp[:4], S0)
    result += sbox(temp[4:], S1)

    result = permute(result, P4)

    left = xor(left, result)

    return left + right


def encrypt(block, key):

    k1, k2 = generate_keys(key)

    temp = permute(block, IP)

    temp = fk(temp, k1)

    temp = temp[4:] + temp[:4]

    temp = fk(temp, k2)

    return permute(temp, IP_INV)


def decrypt(block, key):

    k1, k2 = generate_keys(key)

    temp = permute(block, IP)

    temp = fk(temp, k2)

    temp = temp[4:] + temp[:4]

    temp = fk(temp, k1)

    return permute(temp, IP_INV)


key = "0111111101"
iv = "10101010"

plaintext = [
    "00000001",
    "00100011"
]

# CBC Encryption
ciphertext = []

previous = iv

for block in plaintext:

    temp = xor(block, previous)

    cipher = encrypt(temp, key)

    ciphertext.append(cipher)

    previous = cipher


print("Ciphertext:")
print(" ".join(ciphertext))


# CBC Decryption
decrypted = []

previous = iv

for block in ciphertext:

    temp = decrypt(block, key)

    plain = xor(temp, previous)

    decrypted.append(plain)

    previous = block


print("Decrypted:")
print(" ".join(decrypted))
